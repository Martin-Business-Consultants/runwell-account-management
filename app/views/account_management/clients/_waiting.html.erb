<%# locals: (client:) %>
<% items = AccountManagement::Waiting.for_client(client) %>
<% if items.any? %>
  <section class="settings__section">
    <header>
      <h2 class="divider">Waiting on them <span class="txt-subtle"><%= items.size %></span></h2>
    </header>
    <ul class="settings__scrollable-list">
      <% items.each do |item| %>
        <%# herb:key item.key %>
        <li class="flex align-center gap-half txt-small">
          <div class="txt-align-start min-width flex-item-grow">
            <strong><%= item.label %></strong>
            <div class="txt-x-small txt-subtle"><%= item.detail %></div>
          </div>
          <%= link_to "Nudge", new_account_management_nudge_path(subject: "#{item.record.class.name.demodulize}:#{item.record.id}"), class: "btn txt-x-small" %>
        </li>
      <% end %>
    </ul>
  </section>
<% end %>
