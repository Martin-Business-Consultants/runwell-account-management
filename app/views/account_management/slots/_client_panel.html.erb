<%# locals: (client:) %>
<%# Account management on a client: who answers for it and how often it should hear from us,
    how it's doing, when it last heard from us (and its debriefed calls), and its meetings and
    rhythm. %>
<% if AccountManagement::Member.active?(Current.user) %>
  <% lead = client.account_lead %>
  <% pulse = AccountManagement::Pulse.new([ client.id ]) %>
  <%= render "account_management/clients/lead", client: client, lead: lead %>
  <%= render "account_management/clients/health", client: client %>
  <%= render "account_management/clients/contact", client: client, pulse: pulse, lead: lead %>
  <%= render "account_management/clients/meetings", client: client %>
<% else %>
  <section class="settings__section">
    <p class="txt-small txt-subtle margin-none">
      Account management isn’t switched on for you, so this <%= term(:client).downcase %>’s lead, meetings and contact log aren’t shown.
      <% if can?(:manage_settings) %>
        <%= link_to "Switch it on", account_management_settings_path, class: "txt-link" %>.
      <% else %>
        Ask an owner to switch it on.
      <% end %>
    </p>
  </section>
<% end %>
