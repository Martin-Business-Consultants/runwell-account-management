<% @page_title = "Account management" %>
<%= render "settings/header", current: :account_management %>

<section class="settings">
  <div class="settings__panel panel shadow txt-align-start">
    <section class="settings__section flex flex-column gap">
      <header>
        <h2 class="divider">Who it’s on for <span class="txt-subtle"><%= @members.size %></span></h2>
      </header>
      <p class="txt-small txt-subtle margin-none">
        Account management is for the people who look after <%= term(:client, count: 2).downcase %>: usually your project managers. Each one gets Accounts in their menu, a Today list, and warnings on home. They choose the <%= term(:client, count: 2).downcase %> they work with in My clients. Only they can lead or back up a <%= term(:client).downcase %>.
      </p>
      <% if @members.any? %>
        <ul class="settings__scrollable-list">
          <% @members.each do |member| %>
            <%# herb:key member.id %>
            <li class="flex align-center gap-half txt-small">
              <%= person_tag member.user %>
              <div class="txt-align-start min-width flex-item-grow">
                <strong><%= member.user.display_name %></strong>
                <div class="txt-x-small txt-subtle">
                  <%= member.all_clients? ? "Every #{term(:client).downcase}" : pluralize(member.clients.count, term(:client).downcase) %> ·
                  leads <%= @leading.fetch(member.user_id, 0) %><% if member.away? %> · away until <%= l member.away_until, format: :long %><% end %>
                </div>
              </div>
              <details class="txt-align-start">
                <summary class="btn txt-x-small"><%= member.away? ? "Away" : "Set away" %></summary>
                <%= form_with url: account_management_member_path(member), method: :patch, scope: :member, namespace: dom_id(member), class: "flex align-center gap-half txt-small margin-block-start" do |form| %>
                  <%= date_input form, :away_until, value: member.away_until, class: "input", aria: { label: "Away until" } %>
                  <button type="submit" class="btn btn--link txt-x-small">Save</button>
                <% end %>
              </details>
              <%= button_to "Switch off", account_management_member_path(member), method: :delete, class: "btn txt-x-small txt-negative" %>
            </li>
          <% end %>
        </ul>
      <% else %>
        <p class="txt-small margin-none">It isn’t on for anyone yet. Switch it on for your project managers below.</p>
      <% end %>
    </section>

    <% if @others.any? %>
      <section class="settings__section flex flex-column gap">
        <header>
          <h2 class="divider">Switch it on for</h2>
        </header>
        <ul class="settings__scrollable-list">
          <% @others.each do |user| %>
            <%# herb:key user.id %>
            <li class="flex align-center gap-half txt-small">
              <%= person_tag user %>
              <div class="txt-align-start min-width flex-item-grow">
                <strong><%= user.display_name %></strong>
                <div class="txt-x-small txt-subtle"><%= user.role.humanize %></div>
              </div>
              <%= button_to "Switch on", account_management_members_path, params: { user_id: user.id }, class: "btn btn--link txt-x-small" %>
            </li>
          <% end %>
        </ul>
      </section>
    <% end %>

    <section class="settings__section flex flex-column gap">
      <header>
        <h2 class="divider">What each person does</h2>
      </header>
      <p class="txt-small txt-subtle margin-none">
        When a call is debriefed, each piece of work goes to whoever’s tags fit it, then whoever has less open. Any words work: code, design, content, seo, ads…
      </p>
      <ul class="settings__scrollable-list">
        <% (@members.map(&:user) + @others.to_a).sort_by(&:display_name).each do |user| %>
          <%# herb:key user.id %>
          <li class="flex align-center gap-half txt-small">
            <%= person_tag user %>
            <strong class="min-width"><%= user.display_name %></strong>
            <hr class="separator--horizontal flex-item-grow txt-subtle" aria-hidden="true">
            <%= form_with url: account_management_person_path(user), method: :patch, scope: :expertise, namespace: "expertise_#{user.id}", class: "flex align-center gap-half" do |form| %>
              <%= form.text_field :tags, value: @expertise.fetch(user.id, []).join(", "), class: "input txt-small", autocomplete: "off", placeholder: "code, design…", aria: { label: "#{user.display_name}’s expertise" } %>
              <button type="submit" class="btn txt-x-small txt-nowrap">Save</button>
            <% end %>
          </li>
        <% end %>
      </ul>
    </section>

    <section class="settings__section flex flex-column gap-half">
      <header>
        <h2 class="divider">Next</h2>
      </header>
      <ul class="record-steps txt-small">
        <li>Each person picks their <%= term(:client, count: 2).downcase %> in <%= link_to "My clients", account_management_portfolio_path, class: "txt-link" %>.</li>
        <li>On each <%= term(:client).downcase %>’s Account management tab, choose its lead and a backup.</li>
        <li>The <%= link_to "guide", account_management_guide_path, class: "txt-link" %> walks through a week of using it.</li>
      </ul>
    </section>
  </div>
</section>
