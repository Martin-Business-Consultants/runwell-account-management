<% @page_title = "Nudge #{@client.name}" %>
<% content_for :header do %>
  <%= parent_page @client.name, client_path(@client, tab: "plugin-account_management") %>
<% end %>

<section class="settings settings--split">
  <div class="settings__panel panel shadow txt-align-start">
    <h1 class="page-title"><%= @page_title %></h1>
    <%= form_with url: account_management_nudges_path, scope: :nudge, class: "flex flex-column gap txt-small" do |form| %>
      <%= hidden_field_tag :subject, params[:subject], id: nil %>
      <fieldset class="flex flex-column gap-half borderless pad-none margin-none">
        <legend class="font-weight-bold margin-block-end-half">To</legend>
        <% @client.contacts.active.where.not(email: [ nil, "" ]).ordered.each do |contact| %>
          <%# herb:key contact.id %>
          <label class="flex align-center gap-half">
            <%= check_box_tag "contact_ids[]", contact.id, @recipients.include?(contact), id: "nudge_contact_#{contact.id}" %>
            <span><%= contact.name %> <span class="txt-subtle"><%= contact.email %></span></span>
          </label>
        <% end %>
      </fieldset>
      <label class="flex flex-column gap-half">
        <span class="font-weight-bold">Subject</span>
        <%= form.text_field :title, value: @title, class: "input full-width", autocomplete: "off" %>
      </label>
      <div class="flex flex-column gap-half">
        <span class="font-weight-bold">Message</span>
        <%= rich_text_field_tag "nudge[body]", @body, id: "nudge_body" %>
      </div>
      <button type="submit" class="btn btn--link center">Send the nudge</button>
    <% end %>
  </div>

  <aside class="settings__panel settings__panel--side panel shadow txt-align-start">
    <ul class="record-steps txt-small">
      <li>It goes from <%= Setting.current.mail_sender %>, with replies to you.</li>
      <li>It’s logged as contact with <%= @client.name %>.</li>
      <li>Keep it short and specific: what you need, and by when.</li>
    </ul>
  </aside>
</section>
