<%# locals: (form_id:) %>
<%= form_with url: account_management_touches_path, scope: :touch, id: form_id, namespace: "quick_action", class: "flex flex-column gap txt-small", data: { turbo_frame: "_top" } do |form| %>
  <div class="flex flex-wrap gap-half">
    <%= form.select :channel, AccountManagement::Touch::CHANNELS.invert, {}, class: "input input--select flex-item-grow", aria: { label: "How" } %>
    <%= form.select :direction, AccountManagement::Touch::DIRECTIONS.invert, {}, class: "input input--select flex-item-grow", aria: { label: "Who reached out" } %>
    <%= date_input form, :happened_on, value: Date.current, class: "input flex-item-grow", aria: { label: "When" } %>
  </div>
  <%= form.text_field :summary, class: "input full-width", autocomplete: "off", placeholder: "What it was about", aria: { label: "What it was about" } %>
  <p class="txt-x-small txt-subtle margin-none">It counts as contact for the <%= term(:client).downcase %>’s cadence, and answers any request waiting on a reply.</p>
  <div class="flex gap-half justify-center">
    <button type="submit" class="btn btn--link">Log contact</button>
  </div>
<% end %>
