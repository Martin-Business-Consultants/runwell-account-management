<p>Hi <%= @contact.name %>,</p>
<% if @paper == "agenda" %>
  <p>Here’s the agenda for <strong><%= @meeting.title %></strong> on <%= l @meeting.starts_at.in_time_zone, format: :long %> (<%= Time.zone.name %>).</p>
  <%= rich_text @meeting.agenda %>
<% else %>
  <p>Thanks for your time at <strong><%= @meeting.title %></strong>. Here’s what we covered and agreed.</p>
  <%= rich_text @meeting.recap %>
  <% items = @meeting.action_items %>
  <% if items.any? %>
    <p><strong>Action items</strong></p>
    <ul>
      <% items.each do |item| %>
        <li><%= item.description %>: <%= item.owner_name %><% if item.due_on %>, by <%= l item.due_on, format: :long %><% end %></li>
      <% end %>
    </ul>
  <% end %>
<% end %>
