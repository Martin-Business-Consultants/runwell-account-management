<%# locals: (item:) %>
<% case item %>
<% when AccountManagement::Meeting %>
  <%= link_to account_management_meeting_path(item), class: "txt-ink txt-align-start flex align-center gap-half" do %>
    <div class="min-width flex-item-grow">
      <strong><%= item.state == "recap_due" ? "Recap" : "Agenda" %>: <%= item.title %></strong>
      <div class="txt-x-small txt-subtle"><%= item.client.name %> · <%= item.when_label %> · <%= account_paper_line(item, item.state == "recap_due" ? :recap : :agenda) %></div>
    </div>
    <%= account_meeting_tag item %>
  <% end %>
<% when AccountManagement::Alert %>
  <%= link_to client_path(item.client, tab: "plugin-account_management"), class: "txt-ink txt-align-start flex align-center gap-half" do %>
    <div class="min-width flex-item-grow">
      <strong><%= item.client.name %></strong>
      <div class="txt-x-small txt-subtle"><%= item.detail.upcase_first %></div>
    </div>
    <%= account_status_tag item.kind == :quiet ? "quiet" : "attention" %>
  <% end %>
<% when ::Request %>
  <%= link_to request_path(item), class: "txt-ink txt-align-start flex align-center gap-half" do %>
    <div class="min-width flex-item-grow">
      <strong>Answer: <%= item.subject %></strong>
      <div class="txt-x-small txt-subtle"><%= item.client&.name %> · <%= AccountManagement::Replies.late?(item) ? "was due" : "due" %> by <%= l AccountManagement::Replies.due_at(item), format: :short %></div>
    </div>
    <%= account_status_tag AccountManagement::Replies.late?(item) ? "late" : "attention" %>
  <% end %>
<% when ::Client %>
  <%= link_to client_path(item, tab: "plugin-account_management"), class: "txt-ink txt-align-start flex align-center gap-half" do %>
    <div class="min-width flex-item-grow">
      <strong><%= item.name %></strong>
      <div class="txt-x-small txt-subtle">Nobody leads it: choose who answers for it</div>
    </div>
    <%= account_status_tag "attention" %>
  <% end %>
<% end %>
